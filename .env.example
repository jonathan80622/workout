# Public Google OAuth client ID for browser-only Drive access.
# The OAuth client must allow this app's Vercel origin and localhost during development.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-side Drive credentials used only by the PT media proxy.
# The refresh token belongs to the workout owner's Google account; the PT never authenticates with Google.
# GOOGLE_DRIVE_CLIENT_ID may be omitted when it is the same OAuth client as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Password required by /pt before the app serves your shared Drive workout JSON and video bytes.
PT_VIEW_PASSWORD=

# Optional fallback if you want a stable /pt URL without ?dataFileId=...
NEXT_PUBLIC_WORKOUT_DATA_FILE_ID=

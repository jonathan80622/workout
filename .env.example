# Public Google OAuth client ID used by the browser and server OAuth flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Secret for the same Google Cloud Web application OAuth client.
GOOGLE_DRIVE_CLIENT_SECRET=

# Optional override if the server OAuth client ID differs from the browser client ID.
GOOGLE_DRIVE_CLIENT_ID=

# Optional separate encryption key for refresh tokens stored in Redis.
# If omitted, GOOGLE_DRIVE_CLIENT_SECRET is used as the encryption secret.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# Upstash Redis REST credentials. Connecting Upstash Redis to the Vercel project
# normally injects these automatically. KV_REST_API_URL / KV_REST_API_TOKEN are
# also accepted for compatibility with older Vercel storage integrations.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password required by /pt before the app serves shared workout state or video bytes.
PT_VIEW_PASSWORD=

# Optional fallback if you want a stable /pt URL without ?dataFileId=...
NEXT_PUBLIC_WORKOUT_DATA_FILE_ID=

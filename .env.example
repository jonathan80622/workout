# Google OAuth web client used for sign-in and Drive access.
# Its authorized redirect URIs must include <origin>/api/auth/google/callback for each origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string of at least 32 characters (e.g. `openssl rand -base64 48`). Signs sessions and
# encrypts stored Google refresh tokens; changing it signs everyone out and requires reconnecting Drive.
AUTH_SECRET=

# Password required by /pt before the PT portal loads workouts.
PT_VIEW_PASSWORD=

# Server-side Mixpanel project token used by /api/analytics.
MIXPANEL_PROJECT_TOKEN=

# Set to true to send client analytics events to /api/analytics.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional server-side analytics logging for local verification.
ANALYTICS_DEBUG=false

# Server-side PostgreSQL connection string for Prisma ORM. Never expose as NEXT_PUBLIC_*.
DATABASE_URL=

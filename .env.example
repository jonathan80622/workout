# Google OAuth web client used in the browser for sign-in and Drive access.
# Its authorized JavaScript origins must include this app's Vercel origin and localhost during development.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Password required by /pt before the PT portal loads workouts.
PT_VIEW_PASSWORD=

# Server-side Mixpanel project token used by /api/analytics.
MIXPANEL_PROJECT_TOKEN=

# Set to true to send client analytics events to /api/analytics.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional server-side analytics logging for local verification.
ANALYTICS_DEBUG=false

# Server-side PostgreSQL connection string for Prisma ORM. Never expose as NEXT_PUBLIC_*.
DATABASE_URL=

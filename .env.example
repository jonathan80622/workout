# Google OAuth web client used in the browser for sign-in and Drive access.
# Its authorized JavaScript origins must include this app's Vercel origin and localhost during development.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Password required by /pt before the PT portal loads workouts.
PT_VIEW_PASSWORD=

# Server-side Mixpanel project token used by /api/analytics.
MIXPANEL_PROJECT_TOKEN=

# Optional GA4 Measurement Protocol destination used by the durable analytics delivery worker.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Manual analytics delivery endpoint accepts this secret or CRON_SECRET. No automatic schedule.
OBSERVABILITY_CRON_SECRET=

# Optional server-side analytics logging for local verification.
ANALYTICS_DEBUG=false

# Server-side PostgreSQL connection string for Prisma ORM. Never expose as NEXT_PUBLIC_*.
DATABASE_URL=
OPENAI_API_KEY=
# Optional; defaults to gpt-5.5.
OPENAI_CHAT_MODEL=
# Later strict agent tracing will require Blob-backed artifacts and a capture mode.
BLOB_READ_WRITE_TOKEN=
OBSERVABILITY_TRACE_CAPTURE_MODE=strict
# Redis for resumable Bumstead replies and cross-instance stop (Upstash / Vercel Redis URL).
REDIS_URL=

# LINE warmup reminder (/api/cron/warmup-reminder) broadcasts to every friend of the Official Account.
# Set in Vercel Production only; never NEXT_PUBLIC_*. From LINE Developers > Messaging API channel > Basic settings.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Random value; Vercel Cron sends it as `Authorization: Bearer <value>`. Without it the route refuses to run.
CRON_SECRET=

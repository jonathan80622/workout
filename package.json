{
  "name": "workout-tracker-pt-report",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "node scripts/check-auth-env.mjs && next build",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:deploy:verify": "node scripts/deploy-database.mjs",
    "db:verify": "node scripts/verify-database.mjs",
    "db:import:workout-json": "node scripts/import-workout-json.mjs",
    "db:import:workout-json:apply": "node scripts/import-workout-json.mjs --apply",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/react": "4.0.140",
    "@prisma/client": "6.17.1",
    "ai": "7.0.137",
    "canvas-confetti": "^1.9.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "mixpanel": "^0.24.0",
    "motion": "^12.23.24",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "6.3.0",
    "resumable-stream": "2.2.13",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "postcss": "^8.5.3",
    "prisma": "6.17.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2"
  }
}

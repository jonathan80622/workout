generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  sessions          Session[]
  profile           UserProfile?
  workouts          Workout[]
  machines          MachinePreset[]
  scheduledSessions ScheduledSession[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName    String   @default("")
  ptName        String   @default("")
  appTitle      String   @default("Workout Studio")
  preferredUnit String   @default("lbs")
  themeColor    String   @default("ios-blue")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MachinePreset {
  id                  String   @id @default(cuid())
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  category            String
  defaultSeatSettings String   @default("")
  equipmentType       String   @default("pin_select")
  targetDescription   String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Workout {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  date               DateTime
  startTime          String?
  endTime            String?
  durationMinutes    Int           @default(0)
  unit               String        @default("lbs")
  clientName         String        @default("")
  ptName             String        @default("")
  ptNotes            String        @default("")
  isCompleted        Boolean       @default(false)
  runningDistance    Float?
  runningTimeMinutes Float?
  exercises          ExerciseLog[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model ExerciseLog {
  id                 String         @id @default(cuid())
  workoutId          String
  workout            Workout        @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  machineName        String
  category           String
  seatSettings       String         @default("")
  notes              String         @default("")
  orderIndex         Int            @default(0)
  distance           Float?
  runningTimeMinutes Float?
  sets               WorkoutSet[]
  muscleFeeling      MuscleFeeling?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model WorkoutSet {
  id                 String      @id @default(cuid())
  exerciseId         String
  exercise           ExerciseLog @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setNumber          Int
  type               String      @default("working")
  weight             Float       @default(0)
  reps               Int         @default(0)
  completed          Boolean     @default(false)
  rpe                Float?
  distance           Float?
  runningTimeMinutes Float?
}

model MuscleFeeling {
  id            String      @id @default(cuid())
  exerciseId    String      @unique
  exercise      ExerciseLog @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  targetMuscles String      @default("[]")
  sorenessLevel String      @default("none")
  pumpQuality   Int         @default(4)
  jointComfort  String      @default("great")
  notes         String      @default("")
  quickTags     String      @default("[]")
}

model ScheduledSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  scheduledDate DateTime
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
